# Copy to .env and fill in. .env is gitignored.

# Which LLM backend to use: gemini | groq | ollama
LLM_PROVIDER=gemini

# --- Gemini (https://aistudio.google.com/apikey — free tier) ---
GEMINI_API_KEY=
# Verify the exact id for your key with: python scripts/list_models.py
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Groq (https://console.groq.com/keys — free tier) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Ollama (fully local, no key: `ollama pull qwen2.5:7b`) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- Data ---
DATA_CSV=data/support_tickets.csv

# Reference "today" for relative date questions ("this week", "last month").
# Leave blank to use the newest created_at in the dataset. See README §Known limitations.
AS_OF_DATE=

# --- Safety rails on generated SQL ---
SQL_TIMEOUT_SECONDS=5
SQL_MAX_ROWS=200
